{
  // MSC EDGAR enrichment Worker.
  //   • serves the HTML UI (public/) as static assets
  //   • /api/* endpoints drive the crawl + report progress
  //   • a 1-minute Cron Trigger advances the backfill in bounded, resumable ticks
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "msc-edgar",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker before serving a static asset so we can set no-store on the
    // dashboard HTML (otherwise the edge serves index.html directly and caches a
    // stale build after deploys).
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "msc-edgar",
      "database_id": "6a8c8a07-27cc-4744-9657-4b9d5c1af68e"
    }
  ],

  "triggers": {
    // Every minute. Each tick is internally rate-limited and request-budgeted,
    // so this paces a multi-day backfill without tripping EDGAR limits.
    "crons": ["* * * * *"]
  },

  "vars": {
    // SEC requires a real contact in the User-Agent.
    "USER_AGENT": "Manhattan Street Capital feri@manhattanstreetcapital.com",
    // Max EDGAR fetches per cron tick. Free plan caps subrequests at 50/invocation,
    // so keep <=45 on free; raise to a few hundred on Workers Paid for a faster backfill.
    "MAX_REQUESTS_PER_TICK": "40",
    // Target requests/second to EDGAR (ceiling is 10/s per UA; we stay at 5).
    "REQUESTS_PER_SECOND": "5",
    // Layer 4 (email finding). EMAIL_REQUEST_RESERVE requests/tick are held back
    // exclusively for email so it's never starved by discovery/officers/company;
    // EMAIL_PER_TICK is just an upper bound on companies/tick (the reserve is the
    // real limiter at ~2-4 requests/company). EMAIL_SCRAPE_PAGES = site pages
    // scraped per trusted company for real mailto: addresses.
    "EMAIL_PER_TICK": "40",
    "EMAIL_REQUEST_RESERVE": "16",
    "EMAIL_SCRAPE_PAGES": "3",
    // Web-search domain discovery (optional). The SEARCH_API_KEY itself is a
    // wrangler secret, not here. Quota guards keep usage in the provider's free
    // tier: at most SEARCH_MAX_PER_TICK lookups/tick and SEARCH_MONTHLY_CAP/month.
    "SEARCH_PROVIDER": "brave",
    "SEARCH_MONTHLY_CAP": "1800",
    "SEARCH_MAX_PER_TICK": "1",
    // HTTPS email verification (optional; VERIFY_API_KEY is a wrangler secret).
    // Verifalia free tier ≈ 25/day, so daily cap 24 / monthly 740 keeps it free.
    "VERIFY_API_PROVIDER": "verifalia",
    "VERIFY_API_DAILY_CAP": "24",
    "VERIFY_API_MONTHLY_CAP": "740",
    "VERIFY_API_PER_TICK": "1"
  },

  "observability": { "enabled": true }
}
