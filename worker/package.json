{
  "name": "msc-edgar-worker",
  "version": "0.1.0",
  "private": true,
  "description": "MSC EDGAR enrichment — all-Cloudflare Worker (discovery + company + officers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute msc-edgar --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute msc-edgar --remote --file=./schema.sql",
    "tick:local": "wrangler dev --test-scheduled"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.1",
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
